# Copy to .env.local for development. Never commit real secrets.

# Where contact-form submissions are relayed to (e.g. a transactional email API key)
CONTACT_FORM_TO_EMAIL=studio@kilofedi.com
CONTACT_FORM_PROVIDER_API_KEY=

# Optional: site URL used for canonical/OG tags in production
NEXT_PUBLIC_SITE_URL=https://kilofedi.com
